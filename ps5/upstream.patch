diff --git a/xboxrecomp/src/nv2a_vk/flare_fix.h b/xboxrecomp/src/nv2a_vk/flare_fix.h
new file mode 100644
index 0000000..c4f9693
--- /dev/null
+++ b/xboxrecomp/src/nv2a_vk/flare_fix.h
@@ -0,0 +1,172 @@
+/* FLARE_FIX -- NFSU1 light trails at 30 Hz while the game renders at 60.
+ *
+ * NFSU1 draws its light halos (car lights, street lamps) through a trail
+ * buffer, a 640x480 colour surface that is never cleared. Every rendered
+ * frame (sub_00015370, BLENDCOLOR set at 0x153B4):
+ *   1. decay:  full-screen quad, blend ZERO / CONSTANT_COLOR with blend
+ *              colour 0x008296B4 -> buffer *= (0.51, 0.59, 0.71);
+ *   2. flares: the light-flare quads, SRC_ALPHA / ONE, depth-tested against
+ *              the scene's Z;
+ *   3. bloom:  the blurred quarter-size scene, CONSTANT_ALPHA (0xAA) / ONE;
+ *   4. the buffer is added onto the frame, ONE / ONE.
+ * Steps 1-3 run per frame, so the trail's length and weight were tuned for
+ * the Xbox's 30 fps. At 60 fps (uncapped flip interval) a moving light
+ * leaves its decaying copies twice as close together: they overlap into a
+ * bigger, brighter blob -- oncoming headlights most of all.
+ *
+ * RECOMP_FLARE_FIX=1: steps 1-3 run every frame (the newest flare is always
+ * this frame's, so the halo sits on the lamp: no judder), and the decay
+ * colour is set per frame from the real frame time, k_frame =
+ * k'^(dt / 33.3 ms) per channel (k' below; 2.5 ms <= dt <= 100 ms), so the
+ * trail lasts the same time at any frame rate.
+ * =3 (the first version, kept for A/B): steps 1-3 once per 33.3 ms of real
+ * time and skipped otherwise, step 4 every frame. At 60 fps the halo is
+ * 16 ms old on every second frame and the cadence follows vsync jitter --
+ * with a short trail that flickers. =2: as 3, every second frame regardless
+ * of time (slow hosts). Default 0: behaviour unchanged.
+ *
+ * Trail shape (with the fix on; only the decay colour of step 1 changes, no
+ * extra pass, the newest flare keeps full intensity). A copy left n updates
+ * ago weighs k^n (k = the decay colour per channel), so it falls below a
+ * visibility threshold e after n = ln(e) / ln(k) updates.
+ *   RECOMP_FLARE_TRAIL=t (default 0.10; 1 = the Xbox's, i.e. the first
+ *     FLARE_FIX build): decay k^(1/t) gives n' = t * n, exactly t times
+ *     the length.
+ *   RECOMP_FLARE_TRAIL_OPACITY=o (default 0.7; 1 = none): every older copy
+ *     a further factor o per update, so copy n weighs (o * k^(1/t))^n.
+ * Decay colour k' = o * k^(1/t), instead of k = (0.510, 0.588, 0.706).
+ * Defaults (t 0.10, o 0.7): k' = (0.0008, 0.0035, 0.021), blend colour
+ * 0x00000105 -- the previous copy keeps 0.1 / 0.4 / 2 % (Xbox 51 / 59 /
+ * 71 %): practically no trail. t 0.25, o 0.7: (0.047, 0.084, 0.174),
+ * 0x000C152C. t 0.5, o 1: (0.260, 0.346, 0.498), 0x0042587F. Side effect:
+ * a light that stays put builds up to F / (1 - k') instead of F / (1 - k):
+ * with the defaults its halo is the newest flare alone, 0.49 / 0.41 / 0.30
+ * of the Xbox's per channel (t 0.5, o 1: 0.66 / 0.63 / 0.59).
+ *
+ * The trail surface is recognised by its decay pass, not by address.
+ * Header-only (no build list changes); revert = this file, flare_glare.h
+ * and the FLARE_FIX lines in nv2a_vk.c. */
+#ifndef FLARE_FIX_H
+#define FLARE_FIX_H
+
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#define FLARE_FIX_PERIOD 0.0333333   /* the Xbox's 30 fps, seconds */
+#define FLARE_FIX_DECAY  0x008296B4u /* the title's decay colour (0x153B4) */
+
+static int      s_ff_mode = -1;      /* RECOMP_FLARE_FIX: 0 off, 1 per frame, 2 every 2nd frame, 3 33.3 ms */
+static int      s_ff_glare;          /* RECOMP_FLARE_GLARE: 0 off, 1 on, 2 even frames only (flare_glare.h) */
+static uint32_t s_ff_trail_va;       /* the trail surface, once seen */
+static uint32_t s_ff_trail_frame = ~0u;   /* frame of its last decay pass */
+static uint32_t s_ff_decay = FLARE_FIX_DECAY;
+static double   s_ff_k[3];           /* k' per channel (B, G, R) per 33.3 ms */
+
+static double flare_fix_now(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return (double)t.tv_sec + t.tv_nsec / 1e9;
+}
+
+static void flare_fix_init(void)
+{
+    const char *e = getenv("RECOMP_FLARE_FIX");
+    s_ff_mode = e && *e >= '1' && *e <= '3' ? *e - '0' : 0;
+    e = getenv("RECOMP_FLARE_GLARE");
+    s_ff_glare = e && (*e == '1' || *e == '2') ? *e - '0' : 0;
+    if (s_ff_mode) {
+        double t = 0.10, o = 0.7;
+        int i;
+        e = getenv("RECOMP_FLARE_TRAIL");
+        if (e && *e)
+            t = atof(e);
+        if (!(t >= 0.05 && t <= 4.0))
+            t = 0.10;
+        e = getenv("RECOMP_FLARE_TRAIL_OPACITY");
+        if (e && *e)
+            o = atof(e);
+        if (!(o >= 0.0 && o <= 1.0))
+            o = 0.7;
+        s_ff_decay = 0;
+        for (i = 0; i < 24; i += 8) {
+            double k = ((FLARE_FIX_DECAY >> i) & 0xFF) / 255.0;
+            s_ff_k[i / 8] = o * pow(k, 1.0 / t);
+            s_ff_decay |= (uint32_t)lround(255.0 * s_ff_k[i / 8]) << i;
+        }
+        fprintf(stderr, "[flare] trail %s, length x%.2f, opacity %.2f (decay %08X -> %08X per 33.3 ms)\n",
+                s_ff_mode == 1 ? "updated every frame, decay from frame time"
+                : s_ff_mode == 3 ? "updated at 30 Hz (33.3 ms)" : "updated every 2nd frame",
+                t, o, FLARE_FIX_DECAY, s_ff_decay);
+    }
+}
+
+/* 1: drop this draw (a trail-buffer update on a frame that is not a 30 Hz
+ * tick). May point *pb / *pr at a copy with the trail length's decay. */
+static int flare_fix_draw(const Nv2aRawBatch **pb, const uint32_t **pr, uint32_t frame)
+{
+    static int tick;
+    static uint32_t n_frames, n_ticks;
+    static double acc, last, log_t;
+    static Nv2aRawBatch cb;
+    static uint32_t cr[0x2000 / 4];
+    const Nv2aRawBatch *b = *pb;
+    const uint32_t *r = *pr;
+
+    if (s_ff_mode < 0)
+        flare_fix_init();
+    if (!s_ff_mode && !s_ff_glare)
+        return 0;
+    /* The decay pass opens each frame's update of the trail buffer. */
+    if (r[0x304 / 4] && r[0x344 / 4] == 0 && r[0x348 / 4] == 0x8001 && r[0x34C / 4] == FLARE_FIX_DECAY) {
+        if (frame != s_ff_trail_frame) {
+            double now = flare_fix_now();
+            s_ff_trail_va = b->surface.color_va;
+            s_ff_trail_frame = frame;
+            if (s_ff_mode == 2) {
+                tick = !tick;
+            } else if (s_ff_mode == 1) {
+                double dt = last ? now - last : FLARE_FIX_PERIOD;
+                int i;
+                last = now;
+                dt = dt < 0.0025 ? 0.0025 : dt > 0.1 ? 0.1 : dt;
+                s_ff_decay = 0;
+                for (i = 0; i < 3; i++)
+                    s_ff_decay |= (uint32_t)lround(255.0 * pow(s_ff_k[i], dt / FLARE_FIX_PERIOD)) << (8 * i);
+                tick = 1;
+            } else if (s_ff_mode == 3) {
+                acc = last ? acc + (now - last) : FLARE_FIX_PERIOD;
+                last = now;
+                tick = acc >= FLARE_FIX_PERIOD;
+                if (tick)
+                    acc = acc >= 2 * FLARE_FIX_PERIOD ? 0 : acc - FLARE_FIX_PERIOD;
+            } else {
+                tick = 1;                       /* glare only: the title's own cadence */
+            }
+            n_frames++;
+            n_ticks += tick;
+            if (!log_t)
+                log_t = now;
+            if (s_ff_mode && now - log_t >= 10.0) {
+                fprintf(stderr, "[flare] trail %08X updated on %u of %u frames\n", s_ff_trail_va, n_ticks, n_frames);
+                n_frames = n_ticks = 0;
+                log_t = now;
+            }
+        }
+        if (tick && s_ff_decay != FLARE_FIX_DECAY) {
+            memcpy(cr, r, sizeof cr);
+            cr[0x34C / 4] = s_ff_decay;
+            cb = *b;
+            cb.regs = cr;
+            *pb = &cb;
+            *pr = cr;
+        }
+    }
+    return s_ff_mode && !tick && frame == s_ff_trail_frame && b->surface.color_va == s_ff_trail_va;
+}
+
+#endif
diff --git a/xboxrecomp/src/nv2a_vk/flare_glare.h b/xboxrecomp/src/nv2a_vk/flare_glare.h
new file mode 100644
index 0000000..67229f7
--- /dev/null
+++ b/xboxrecomp/src/nv2a_vk/flare_glare.h
@@ -0,0 +1,242 @@
+/* FLARE_FIX -- RECOMP_FLARE_GLARE=1 (default 0): a soft warm glare around
+ * the bright lights only.
+ *
+ * Source: the title's light-trail buffer (flare_fix.h), which holds the
+ * light flares and a blurred copy of the scene but not the scene itself,
+ * so street lamps and car lights glare and the rest of the picture does
+ * not. Only its hottest texels count: max(r, g, b) is smoothstep'ed from
+ * the threshold to 1, so a light facing the camera (oncoming headlights,
+ * saturated over a bigger area) glares more than one seen from the side.
+ *
+ * One full-screen pass at flip time, added (ONE / ONE, RGB only) onto the
+ * finished frame before it is presented or dumped -- like the FXAA pass,
+ * outside the title's own draws, so no per-draw CPU work and no state the
+ * title's draws rely on is touched. Per pixel: four short streaks (+-x, +-y,
+ * 8 taps each, quadratic fall-off) and a ring of 8 taps for the halo, tinted
+ * warm white (1.0, 0.95, 0.8). Offsets are in the title's pixels, so the
+ * look does not change with the resolution scale.
+ *
+ * =2: even frames only, an A/B in one run for slow hosts (dump every odd
+ * number of frames).
+ *
+ * Tunables (read once):
+ *   RECOMP_FLARE_GLARE_STRENGTH  streaks, 0.5     (0 = none)
+ *   RECOMP_FLARE_GLARE_LENGTH    streak length, title pixels, 20
+ *   RECOMP_FLARE_GLARE_HALO      halo, 0.3
+ *   RECOMP_FLARE_GLARE_RADIUS    halo radius, title pixels, 5
+ *   RECOMP_FLARE_GLARE_THRESHOLD trail brightness that starts to glare, 0.2
+ * Included after present_fxaa in nv2a_vk.c (uses its statics). */
+#ifndef FLARE_GLARE_H
+#define FLARE_GLARE_H
+
+static const char s_fg_fs[] =
+    "#version 450\n"
+    "layout(set = 0, binding = 0) uniform sampler2D trail;\n"
+    "layout(push_constant) uniform P { vec4 a; vec4 b; } pc;\n"   /* a: px, strength, length; b: threshold, halo, radius */
+    "layout(location = 0) out vec4 o;\n"
+    "vec3 hot(vec2 uv) {\n"
+    "    vec3 c = textureLod(trail, uv, 0.0).rgb;\n"
+    "    return c * smoothstep(pc.b.x, 1.0, max(c.r, max(c.g, c.b)));\n"
+    "}\n"
+    "void main() {\n"
+    "    vec2 uv = gl_FragCoord.xy / vec2(textureSize(trail, 0));\n"
+    "    vec2 px = pc.a.xy;\n"
+    "    const vec2 D[4] = vec2[](vec2(1.0, 0.0), vec2(-1.0, 0.0), vec2(0.0, 1.0), vec2(0.0, -1.0));\n"
+    "    vec3 s = vec3(0.0), h = vec3(0.0);\n"
+    "    for (int d = 0; d < 4; d++)\n"
+    "        for (int i = 1; i <= 8; i++) {\n"
+    "            float t = float(i) / 8.0;\n"
+    "            s += hot(uv + D[d] * (t * pc.a.w) * px) * ((1.0 - t) * (1.0 - t));\n"
+    "        }\n"
+    "    for (int i = 0; i < 8; i++) {\n"
+    "        float a = float(i) * 0.7853982;\n"
+    "        h += hot(uv + vec2(cos(a), sin(a)) * pc.b.z * px);\n"
+    "    }\n"
+    /* 4 rays x sum((1 - i/8)^2) = 4 x 2.1875: a saturated area adds `strength`. */
+    "    vec3 g = s * (pc.a.z / 8.75) + h * (pc.b.y / 8.0);\n"
+    "    o = vec4(g * vec3(1.0, 0.95, 0.8), 0.0);\n"
+    "}\n";
+
+static float flare_glare_env(const char *name, float def)
+{
+    const char *e = getenv(name);
+    float v = e && *e ? (float)atof(e) : def;
+    return v >= 0.0f && v < 1000.0f ? v : def;
+}
+
+static VkPipeline flare_glare_pipe(VkPipelineLayout *lay)
+{
+    static VkDescriptorSetLayout dsl;
+    static VkPipelineLayout pl;
+    static VkPipeline pipe;
+    static int failed;
+    VkDescriptorSetLayoutBinding bd = { 0, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1,
+                                        VK_SHADER_STAGE_FRAGMENT_BIT, NULL };
+    VkDescriptorSetLayoutCreateInfo lci = { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO };
+    VkPushConstantRange pr = { VK_SHADER_STAGE_FRAGMENT_BIT, 0, 32 };
+    VkPipelineLayoutCreateInfo pli = { VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO };
+    VkGraphicsPipelineCreateInfo ci = { VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO };
+    VkPipelineShaderStageCreateInfo st[2];
+    VkPipelineVertexInputStateCreateInfo vi = { VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO };
+    VkPipelineInputAssemblyStateCreateInfo ia = { VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO };
+    VkPipelineViewportStateCreateInfo vp = { VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO };
+    VkPipelineRasterizationStateCreateInfo rs = { VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO };
+    VkPipelineMultisampleStateCreateInfo ms = { VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO };
+    VkPipelineColorBlendAttachmentState ba;
+    VkPipelineColorBlendStateCreateInfo cb = { VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO };
+    VkPipelineDynamicStateCreateInfo dy = { VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO };
+    VkPipelineRenderingCreateInfo rci = { VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO };
+    static const VkDynamicState dyn[] = { VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR };
+    VkFormat fmt = VK_FORMAT_B8G8R8A8_UNORM;   /* every title surface (surf_get) */
+    VkShaderModule vs, fs;
+
+    *lay = pl;
+    if (pipe || failed)
+        return pipe;
+    failed = 1;
+    lci.flags = VK_DESCRIPTOR_SET_LAYOUT_CREATE_PUSH_DESCRIPTOR_BIT_KHR;
+    lci.bindingCount = 1;
+    lci.pBindings = &bd;
+    if (vkCreateDescriptorSetLayout(s_dev, &lci, NULL, &dsl) != VK_SUCCESS)
+        return VK_NULL_HANDLE;
+    pli.setLayoutCount = 1;
+    pli.pSetLayouts = &dsl;
+    pli.pushConstantRangeCount = 1;
+    pli.pPushConstantRanges = &pr;
+    if (vkCreatePipelineLayout(s_dev, &pli, NULL, &pl) != VK_SUCCESS)
+        return VK_NULL_HANDLE;
+    vs = compile(GLSLANG_STAGE_VERTEX, s_pp_vs);
+    fs = compile(GLSLANG_STAGE_FRAGMENT, s_fg_fs);
+    if (vs && fs) {
+        memset(st, 0, sizeof st);
+        st[0].sType = st[1].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+        st[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+        st[0].module = vs;
+        st[0].pName = "main";
+        st[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+        st[1].module = fs;
+        st[1].pName = "main";
+        ia.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+        vp.viewportCount = vp.scissorCount = 1;
+        rs.polygonMode = VK_POLYGON_MODE_FILL;
+        rs.lineWidth = 1.0f;
+        ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+        memset(&ba, 0, sizeof ba);
+        ba.blendEnable = VK_TRUE;
+        ba.srcColorBlendFactor = ba.dstColorBlendFactor = VK_BLEND_FACTOR_ONE;
+        ba.colorBlendOp = VK_BLEND_OP_ADD;
+        ba.srcAlphaBlendFactor = VK_BLEND_FACTOR_ZERO;
+        ba.dstAlphaBlendFactor = VK_BLEND_FACTOR_ONE;
+        ba.alphaBlendOp = VK_BLEND_OP_ADD;
+        ba.colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT | VK_COLOR_COMPONENT_B_BIT;
+        cb.attachmentCount = 1;
+        cb.pAttachments = &ba;
+        dy.dynamicStateCount = 2;
+        dy.pDynamicStates = dyn;
+        rci.colorAttachmentCount = 1;
+        rci.pColorAttachmentFormats = &fmt;
+        ci.pNext = &rci;
+        ci.stageCount = 2;
+        ci.pStages = st;
+        ci.pVertexInputState = &vi;
+        ci.pInputAssemblyState = &ia;
+        ci.pViewportState = &vp;
+        ci.pRasterizationState = &rs;
+        ci.pMultisampleState = &ms;
+        ci.pColorBlendState = &cb;
+        ci.pDynamicState = &dy;
+        ci.layout = pl;
+        if (vkCreateGraphicsPipelines(s_dev, s_pcache, 1, &ci, NULL, &pipe) != VK_SUCCESS)
+            pipe = VK_NULL_HANDLE;
+    }
+    if (vs) vkDestroyShaderModule(s_dev, vs, NULL);
+    if (fs) vkDestroyShaderModule(s_dev, fs, NULL);
+    if (!pipe)
+        LOGE("[flare] glare pipeline failed; glare off\n");
+    failed = !pipe;
+    *lay = pl;
+    return pipe;
+}
+
+/* At flip, s = the surface about to be presented (or dumped). */
+static void flare_glare(VkSurf *s)
+{
+    static float pc[8];
+    static VkSampler smp;
+    VkPipelineLayout lay;
+    VkPipeline pipe;
+    VkSurf *t;
+    VkRenderingAttachmentInfo ca = { VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO };
+    VkRenderingInfo ri = { VK_STRUCTURE_TYPE_RENDERING_INFO };
+    VkViewport vp;
+    VkRect2D sc;
+    VkDescriptorImageInfo ii;
+    VkWriteDescriptorSet wr = { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET };
+
+    /* The trail was updated in the frame this flip ends (vk_flip has
+     * already counted the new one). */
+    if (!s_ff_glare || !s || s_ff_trail_frame + 1 != s_frame || (s_ff_glare == 2 && (s_frame & 1)))
+        return;
+    t = surf_find(s_ff_trail_va);
+    if (!t || t == s || t->w != s->w || t->h != s->h)
+        return;
+    pipe = flare_glare_pipe(&lay);
+    if (!pipe)
+        return;
+    if (!smp) {
+        VkSamplerCreateInfo sci = { VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO };
+        sci.magFilter = sci.minFilter = VK_FILTER_LINEAR;
+        sci.addressModeU = sci.addressModeV = sci.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+        if (vkCreateSampler(s_dev, &sci, NULL, &smp) != VK_SUCCESS)
+            return;
+        pc[2] = flare_glare_env("RECOMP_FLARE_GLARE_STRENGTH", 0.5f);
+        pc[3] = flare_glare_env("RECOMP_FLARE_GLARE_LENGTH", 20.0f);
+        pc[4] = flare_glare_env("RECOMP_FLARE_GLARE_THRESHOLD", 0.2f);
+        pc[5] = flare_glare_env("RECOMP_FLARE_GLARE_HALO", 0.3f);
+        pc[6] = flare_glare_env("RECOMP_FLARE_GLARE_RADIUS", 5.0f);
+        if (pc[4] > 0.99f)
+            pc[4] = 0.99f;
+        fprintf(stderr, "[flare] glare on: strength %.2f length %.0f halo %.2f radius %.0f threshold %.2f\n",
+                pc[2], pc[3], pc[5], pc[6], pc[4]);
+    }
+    pc[0] = 1.0f / (float)t->w;
+    pc[1] = 1.0f / (float)t->h;
+    end_rendering();
+    barrier_all();
+    ca.imageView = s->view;
+    ca.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+    ca.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+    ca.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+    ri.renderArea.extent.width = s->pw;
+    ri.renderArea.extent.height = s->ph;
+    ri.layerCount = 1;
+    ri.colorAttachmentCount = 1;
+    ri.pColorAttachments = &ca;
+    p_begin_rendering(s_cb, &ri);
+    vkCmdBindPipeline(s_cb, VK_PIPELINE_BIND_POINT_GRAPHICS, pipe);
+    vp.x = vp.y = 0.0f;
+    vp.width = (float)s->pw;
+    vp.height = (float)s->ph;
+    vp.minDepth = 0.0f;
+    vp.maxDepth = 1.0f;
+    sc.offset.x = sc.offset.y = 0;
+    sc.extent.width = s->pw;
+    sc.extent.height = s->ph;
+    vkCmdSetViewport(s_cb, 0, 1, &vp);
+    vkCmdSetScissor(s_cb, 0, 1, &sc);
+    ii.sampler = smp;
+    ii.imageView = t->view;
+    ii.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+    wr.dstBinding = 0;
+    wr.descriptorCount = 1;
+    wr.descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+    wr.pImageInfo = &ii;
+    p_push_desc(s_cb, VK_PIPELINE_BIND_POINT_GRAPHICS, lay, 0, 1, &wr);
+    vkCmdPushConstants(s_cb, lay, VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof pc, pc);
+    vkCmdDraw(s_cb, 3, 1, 0, 0);
+    p_end_rendering(s_cb);
+    barrier_all();
+    s_dyn_valid = 0;
+}
+
+#endif
